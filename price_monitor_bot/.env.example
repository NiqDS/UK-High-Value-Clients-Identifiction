# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_token_here

# Default polling interval in minutes (used for newly added items)
DEFAULT_CHECK_INTERVAL_MINUTES=60

# Minimum allowed interval a user can set via /interval
MIN_CHECK_INTERVAL_MINUTES=5

# Maximum number of items a single chat may monitor at once
MAX_MONITORED_ITEMS_PER_USER=10

# Path to the SQLite database file (optional)
DATABASE_PATH=price_monitor.db

# Consecutive failed checks before the user is warned (optional)
MAX_CONSECUTIVE_FAILURES=5

# Per-request HTTP timeout in seconds (optional)
REQUEST_TIMEOUT_SECONDS=20

# --- Playwright fallback (JavaScript-rendered pages) ---
# Render pages in a headless browser when the static scraper finds no price.
USE_PLAYWRIGHT_FALLBACK=true

# Optional: explicit path to a Chromium executable. Leave empty to let
# Playwright use its own managed browser (run `playwright install chromium`).
PLAYWRIGHT_EXECUTABLE_PATH=

# Max seconds to allow a single rendered page load
PLAYWRIGHT_TIMEOUT_SECONDS=30
