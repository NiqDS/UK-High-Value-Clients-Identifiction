# -----------------------------------------------------------------------------
# Copy to .env and fill in.  .env is git-ignored — NEVER commit real secrets.
# -----------------------------------------------------------------------------
# Exchange API credentials.
#   SECURITY-CRITICAL: create the key with TRADE + READ permissions ONLY.
#   Withdrawals MUST be disabled on this key. The bot never calls withdrawals.
EXCHANGE_API_KEY=your-api-key-here
EXCHANGE_API_SECRET=your-api-secret-here
# Passphrase / passphrase-style secret — required by some venues (e.g. Coinbase, OKX).
# Leave blank if your exchange does not use one.
EXCHANGE_API_PASSWORD=

# Telegram bot (from @BotFather). Optional until the approval bot is wired.
TELEGRAM_BOT_TOKEN=
