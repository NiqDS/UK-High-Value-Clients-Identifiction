# systemd unit for running the bot directly (no Docker).
#
# Install:
#   sudo cp deploy/tradingbot.service /etc/systemd/system/tradingbot.service
#   # edit paths/User below to match your install, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tradingbot
#   journalctl -u tradingbot -f          # follow logs
#
# Assumes the project is at /opt/tradingbot with a venv at /opt/tradingbot/.venv
# (python3 -m venv .venv && .venv/bin/pip install .)

[Unit]
Description=tradingbot (risk-first crypto trading bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/tradingbot
EnvironmentFile=/opt/tradingbot/.env
ExecStart=/opt/tradingbot/.venv/bin/python -m tradingbot run
Restart=on-failure
RestartSec=10
# graceful shutdown: the runner stops on SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=30
# light hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
