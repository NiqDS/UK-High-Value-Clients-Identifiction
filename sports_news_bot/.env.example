# =============================================
# Sports News Telegram Bot — Configuration
# =============================================

# [REQUIRED] Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# [OPTIONAL] NewsAPI key for additional sources (newsapi.org)
NEWS_API_KEY=

# News check interval in seconds (default: 900 = 15 minutes)
NEWS_CHECK_INTERVAL=900

# Languages to search news sources in (comma-separated ISO 639-1 codes)
# Supported: en, ru, de, es, fr, it, pt, nl, tr, ar, ja, zh, ko, pl, uk
NEWS_SEARCH_LANGUAGES=en,ru,de,es,fr,it

# Maximum news items to send per user per check cycle
MAX_NEWS_PER_CHECK=3

# Path to SQLite database file
DB_PATH=data/sports_bot.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
